{
  "name": "entrypoint-webapp",
  "version": "0.2.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "supabase:init": "npx supabase init",
    "supabase:start": "npx supabase start",
    "supabase:reset": "npx supabase db reset",
    "supabase:gentypes": "npx supabase gen types typescript --local --schema public > src/types/db.types.ts",
    "supabase:genmigration": "npx supabase db diff --local -f",
    "supabase:restorefromremote": "npx supabase link && npx supabase db dump --data-only -f supabase/backups/remote-data.sql && npx supabase db reset && npm run supabase:loadtolocal",
    "supabase:loadtolocal": "cross-env dotenv -e ./.env.local -- bash -c \"psql --single-transaction --set=ON_ERROR_STOP=1 --command=\\\"SET session_replication_role = replica\\\" --file supabase/backups/remote-data.sql --dbname \\\"\\$DATABASE_URL\\\"\"",
    "supabase": "npm run supabase:init && npm run supabase:start",
    "seed": "npx tsx supabase/seed-data.ts && npx tsx supabase/seed-user.ts && npx tsx supabase/seed-meeting-notes.ts",
    "reset": "npx supabase db reset && npx tsx supabase/seed-data.ts && npx tsx supabase/seed-user.ts && npx tsx supabase/seed-meeting-notes.ts && npm run supabase:gentypes",
    "reset-linked": "PGSSLMODE=require NODE_EXTRA_CA_CERTS=supabase/ssl/supabase.crt NODE_ENV=development bash -c 'npx supabase db reset --linked && npx tsx supabase/seed-data.ts && npx tsx supabase/seed-user.ts && npx tsx supabase/seed-meeting-notes.ts'",
    "db:seed": "npx supabase db reset && npx supabase db push",
    "db:seed-data": "npx tsx supabase/seed-data.ts",
    "db:seed-user": "npx tsx supabase/seed-user.ts",
    "db:backup": "npx tsx supabase/backup-data.ts",
    "db:restore": "npx tsx supabase/restore-data.ts",
    "changeset": "npx @changesets/cli",
    "changeset:version": "changeset version"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0-beta.57",
    "@ai-sdk/react": "^3.0.0-beta.98",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.78.0",
    "@tanstack/react-table": "^8.21.3",
    "@valibot/to-json-schema": "^1.3.0",
    "ai": "^6.0.0-beta.98",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.43.1",
    "effect": "^3.19.3",
    "jaro-winkler": "^0.2.8",
    "lucide-react": "^0.503.0",
    "mixpanel-browser": "^2.70.0",
    "next": "16.0.3",
    "next-themes": "^0.4.6",
    "pg": "^8.15.6",
    "radix-ui": "^1.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.0",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@chromatic-com/storybook": "^3.2.6",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.4.4",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "playwright": "^1.52.0",
    "supabase": "^2.54.11",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.2.8",
    "type-fest": "^4.41.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx}": "npm run lint"
  }
}
