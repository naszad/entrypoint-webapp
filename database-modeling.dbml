

// ====== Core Entities ======

Table districts {
  district_id uuid [pk]
  external_id varchar
  name varchar
  state varchar
  configuration jsonb
  created_at timestamp
  updated_at timestamp
}

Table schools {
  school_id uuid [pk]
  external_id varchar
  name varchar
  district_id uuid [ref: > districts.district_id]
  created_at timestamp
  updated_at timestamp
}

Table terms {
  term_id uuid [pk]
  name varchar // e.g. "Fall 2024"
  start_date date
  end_date date
  school_id uuid [ref: > schools.school_id]
  created_at timestamp
  updated_at timestamp
}

Table courses {
  course_id uuid [pk]
  name varchar [not null]
  course_number varchar [not null]
  state_course_number varchar
  credit_hours int [not null]
  school_id uuid [ref: > schools.school_id, not null]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table course_sections {
  section_id uuid [pk]
  course_id uuid [ref: > courses.course_id, not null]
  grade_level string
  section_number string
  teacher_id uuid [ref: > teachers.teacher_id]
  created_at timestamp [not null]
  updated_at timestamp [not null]
}

Table teachers {
  teacher_id uuid [pk]
  first_name varchar
  last_name varchar
  email varchar
  school_id uuid [ref: > schools.school_id]
  created_at timestamp
  updated_at timestamp
}

Table students {
  student_id uuid [pk]
  first_name varchar
  last_name varchar
  email varchar
  student_number varchar
  grade_level int
  created_at timestamp
  updated_at timestamp
}

Table student_school_memberships {
  student_id uuid [ref: > students.student_id]
  school_id uuid [ref: > schools.school_id]
  start_date date
  end_date date
  created_at timestamp
  updated_at timestamp
}

// ====== Relationship Entities ======

Table section_enrollments {
  section_enrollment_id uuid [pk]
  student_id uuid [ref: > students.student_id]
  section_id uuid [ref: > course_sections.section_id]
  term_id uuid [ref: > terms.term_id]
  start_date date
  end_date date
  absences int
  tardies int
  created_at timestamp
  updated_at timestamp
}

Table grades {
  grade_id uuid [pk]
  section_enrollment_id uuid [ref: > section_enrollments.section_enrollment_id]
  grade_type varchar // e.g. final, midterm
  grade_value decimal // e.g. 85.5
  recorded_at timestamp
}

// ====== App Users ======

Table users {
  user_id uuid [pk]
  email varchar
  first_name varchar
  last_name varchar
  role varchar // e.g. admin, counselor
  created_at timestamp
  updated_at timestamp
}

// A user may belong to one or more schools or districts
Table user_school_memberships {
  user_id uuid [ref: > users.user_id]
  school_id uuid [ref: > schools.school_id]
  role varchar // e.g. admin, teacher, student
  created_at timestamp
  updated_at timestamp
}