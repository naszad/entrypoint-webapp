# Use the official Node.js 22 Alpine image for development.
# Alpine is lightweight, which is good for keeping image sizes down.
FROM node:22-alpine

# Set the working directory inside the container.
# All subsequent commands will run from this path.
WORKDIR /app

# Copy package.json and package-lock.json to the working directory.
COPY package*.json ./

# Install all dependencies, including devDependencies, which are
# needed for the Next.js development server.
RUN npm install

# Expose port 3000 to allow communication with the Next.js dev server
# from your local machine.
EXPOSE 3000

# The default command to start the Next.js development server.
# This will be run when the container starts.
CMD ["npm", "run", "dev"]
